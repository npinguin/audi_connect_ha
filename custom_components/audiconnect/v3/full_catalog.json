{
  "schema_version": 1,
  "brand": "audi",
  "api_families": {
    "cariad": {
      "auth": "auth0",
      "host_owner": "audi_auth_session",
      "notes": "Region host resolved by existing Audi adapter; not configurable as arbitrary URL.",
      "executor": "cariad_v1"
    },
    "mbb": {
      "auth": "legacy",
      "host_owner": "legacy_home_region",
      "notes": "Legacy home-region and authentication retained in existing adapter.",
      "executor": "mbb_legacy_v1"
    }
  },
  "capabilities": {
    "climate": {
      "status": {
        "operations": [
          "cariad.climate.status.batch",
          "cariad.climate.status.probe",
          "mbb.climate.status",
          "cariad.status.activeVentilation",
          "cariad.status.auxiliaryHeating",
          "cariad.status.climatisation",
          "cariad.status.climatisationTimers",
          "cariad.status.hybridCarAuxiliaryHeating",
          "mbb.climate.status.preheater"
        ]
      },
      "control": {
        "start": {
          "operations": [
            "cariad.climate.start.stored",
            "cariad.climate.start.vehicle_settings",
            "mbb.climate.start"
          ]
        },
        "stop": {
          "operations": [
            "cariad.climate.stop",
            "mbb.climate.stop"
          ]
        },
        "window_heating_start": {
          "operations": [
            "cariad.climate.window_heating_start"
          ]
        },
        "window_heating_stop": {
          "operations": [
            "cariad.climate.window_heating_stop"
          ]
        }
      }
    },
    "vehicle_status": {
      "status": {
        "operations": [
          "cariad.status.fuelStatus",
          "cariad.status.lvBattery",
          "cariad.status.measurements",
          "cariad.status.oilLevel",
          "cariad.status.readiness",
          "cariad.status.userCapabilities",
          "cariad.status.vehicleHealthWarnings",
          "cariad.status.vehicleLights",
          "mbb.vehicle_status.status.vehicle_data"
        ]
      }
    },
    "service": {
      "status": {
        "operations": [
          "cariad.status.vehicleHealthInspection"
        ]
      }
    },
    "access": {
      "status": {
        "operations": [
          "cariad.status.access"
        ]
      },
      "control": {
        "lock": {
          "operations": [
            "cariad.access.lock"
          ]
        },
        "unlock": {
          "operations": [
            "cariad.access.unlock"
          ]
        }
      }
    },
    "charging": {
      "status": {
        "operations": [
          "cariad.status.batteryChargingCare",
          "cariad.status.batterySupport",
          "cariad.status.charging",
          "cariad.status.chargingProfiles",
          "cariad.status.chargingTimers",
          "cariad.status.departureProfiles",
          "cariad.status.departureTimers",
          "mbb.charging.status.charger",
          "mbb.charging.status.departure_timer"
        ]
      },
      "control": {
        "start": {
          "operations": [
            "cariad.charging.start",
            "cariad.charging.start.combined"
          ]
        },
        "stop": {
          "operations": [
            "cariad.charging.stop",
            "cariad.charging.stop.combined"
          ]
        }
      }
    },
    "mobility": {
      "status": {
        "operations": [
          "cariad.mobility.status.parkingPosition",
          "cariad.mobility.status.tripStatistics"
        ]
      }
    },
    "remote": {
      "status": {
        "operations": [
          "cariad.status.honkAndFlash"
        ]
      },
      "control": {
        "wake": {
          "operations": [
            "cariad.remote.wake"
          ]
        }
      }
    }
  },
  "operations": {
    "cariad.climate.status.batch": {
      "family": "cariad",
      "method": "GET",
      "path": "/vehicle/v1/vehicles/{VIN}/selectivestatus?jobs={JOBS}",
      "delivery": "existing_poll",
      "priority": 0,
      "response_paths": [
        "climatisation.climatisationStatus.value.climatisationState",
        "climatisation.auxiliaryHeatingStatus.value.climatisationState"
      ]
    },
    "cariad.climate.status.probe": {
      "family": "cariad",
      "method": "GET",
      "path": "/vehicle/v1/vehicles/{VIN}/selectivestatus?jobs=climatisation",
      "delivery": "manual",
      "priority": 30,
      "response_paths": [
        "climatisation.climatisationStatus.value.climatisationState",
        "climatisation.auxiliaryHeatingStatus.value.climatisationState"
      ]
    },
    "mbb.climate.status": {
      "family": "mbb",
      "method": "GET",
      "path": "/fs-car/bs/climatisation/v1/{TYPE}/{COUNTRY}/vehicles/{VIN}/climater",
      "delivery": "existing_poll",
      "priority": 0,
      "response_paths": [
        "climater.status.climatisationStatusData.climatisationState.content"
      ]
    },
    "cariad.climate.start.stored": {
      "family": "cariad",
      "method": "POST",
      "path": "/vehicle/v1/vehicles/{VIN}/climatisation/start",
      "delivery": "manual",
      "priority": 0,
      "request_mode": "bodyless",
      "confirmation": "vehicle_readback",
      "notes": "Manual test only: bodyless climate start; no auto execution or retries. Actual vehicle support must be confirmed."
    },
    "cariad.climate.start.vehicle_settings": {
      "family": "cariad",
      "method": "POST",
      "path": "/vehicle/v1/vehicles/{VIN}/climatisation/start",
      "delivery": "manual",
      "priority": 10,
      "request_mode": "verified_vehicle_target",
      "confirmation": "vehicle_readback",
      "notes": "Opt-in: only vehicle-reported target temp, existing safe settings read-modify-write.",
      "implementation": "not_implemented"
    },
    "cariad.climate.stop": {
      "family": "cariad",
      "method": "POST",
      "path": "/vehicle/v1/vehicles/{VIN}/climatisation/stop",
      "delivery": "manual",
      "priority": 0,
      "request_mode": "bodyless",
      "confirmation": "vehicle_readback"
    },
    "mbb.climate.start": {
      "family": "mbb",
      "method": "POST",
      "path": "/fs-car/bs/climatisation/v1/{TYPE}/{COUNTRY}/vehicles/{VIN}/climater/actions",
      "delivery": "manual",
      "priority": 0,
      "request_mode": "existing_adapter",
      "confirmation": "legacy_request_poll"
    },
    "mbb.climate.stop": {
      "family": "mbb",
      "method": "POST",
